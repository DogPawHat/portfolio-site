---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import { getImage } from "astro:assets";
import parkPath from "../assets/park-path.jpg";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Set when the page's original lives at another address. */
  canonical?: string;
  /** Preload the bold font as well. Only pages with bold type need it. */
  boldFont?: boolean;
}

const defaultImage = await getImage({
  src: parkPath,
  width: 1200,
  format: "jpeg",
  quality: 80,
});

const {
  title,
  description,
  image = defaultImage.src,
  canonical,
  boldFont = false,
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
<link rel="icon" type="image/png" href="/favicon.png" sizes="64x64" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title="Blog - Ciarán Curley"
  href="/rss.xml"
/>
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#3b4823" />

<!-- Font preloads -->
<link
  rel="preload"
  href="/fonts/atkinson-regular.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
{boldFont && (
  <link
    rel="preload"
    href="/fonts/atkinson-bold.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />
)}

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />
