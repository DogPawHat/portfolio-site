---
import Bluesky from "../icons/custom/bluesky.svg";
import Github from "../icons/lucide/github.svg";
import Linkedin from "../icons/lucide/linkedin.svg";
import Mail from "../icons/lucide/mail.svg";
---

<nav aria-label="Contact" class="flex flex-wrap justify-start gap-8 my-8">
  <a
    href="mailto:ciaran.curley.11.11@gmail.com"
    class="flex flex-col items-center group text-white"
    aria-label="Email"
  >
    <div class="p-3 rounded-full bg-paper group-hover:bg-sky transition-colors">
      <Mail class="w-6 h-6 text-ink group-hover:text-paper-bright" />
    </div>
    <span class="mt-2 text-base text-white text-shadow-lg text-shadow-black/80 group-hover:text-sky-pale transition-colors">
      Email
    </span>
  </a>
  <a
    href="https://bsky.app/profile/dogpawhat.tech"
    class="flex flex-col items-center group text-white"
    aria-label="Bluesky"
  >
    <div class="p-3 rounded-full bg-paper group-hover:bg-sky transition-colors">
      <Bluesky class="w-6 h-6 text-ink group-hover:text-paper-bright" />
    </div>
    <span class="mt-2 text-base text-white text-shadow-lg text-shadow-black/80 group-hover:text-sky-pale transition-colors">
      Bluesky
    </span>
  </a>
  <a
    href="https://github.com/dogpawhat"
    class="flex flex-col items-center group text-white"
    aria-label="GitHub"
  >
    <div class="p-3 rounded-full bg-paper group-hover:bg-sky transition-colors">
      <Github class="w-6 h-6 text-ink group-hover:text-paper-bright" />
    </div>
    <span class="mt-2 text-base text-white text-shadow-lg text-shadow-black/80 group-hover:text-sky-pale transition-colors">
      GitHub
    </span>
  </a>
  <a
    href="https://www.linkedin.com/in/dogpawhat/"
    class="flex flex-col items-center group text-white"
    aria-label="LinkedIn"
  >
    <div class="p-3 rounded-full bg-paper group-hover:bg-sky transition-colors">
      <Linkedin class="w-6 h-6 text-ink group-hover:text-paper-bright" />
    </div>
    <span class="mt-2 text-base text-white text-shadow-lg text-shadow-black/80 group-hover:text-sky-pale transition-colors">
      LinkedIn
    </span>
  </a>
</nav>
