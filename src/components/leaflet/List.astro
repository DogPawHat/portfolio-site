---
import type { ListItem } from "../../lib/leaflet/prepare";

interface Props {
  ordered: boolean;
  start?: number;
  items: ListItem[];
}

const { ordered, start, items } = Astro.props;
const Tag = ordered ? "ol" : "ul";
---

<Tag start={ordered && start && start !== 1 ? start : undefined}>
  {items.map((item) => (
    <li>
      {item.checked !== undefined && (
        <input type="checkbox" checked={item.checked} disabled />
      )}
      <Fragment set:html={item.html} />
      {item.children.length > 0 && (
        <Astro.self ordered={ordered} items={item.children} />
      )}
    </li>
  ))}
</Tag>
