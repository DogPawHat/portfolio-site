---
import SocialLinks from "../components/SocialLinks.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <div class="flex flex-col items-start text-left">
    <h1 class="text-6xl md:text-8xl font-normal tracking-tight text-white text-shadow-lg text-shadow-black/50 mb-6">
      Ciarán Curley
    </h1>

    <p class="text-xl text-white text-shadow-lg text-shadow-black/80 mb-4 max-w-2xl">
      I'm a software engineer based in Dublin, Ireland with over 8 years of
      building web applications. I specialize in TypeScript, React, and modern
      web technologies.
    </p>

    <a
      href="/blog/"
      class="text-xl text-white text-shadow-lg text-shadow-black/80 underline underline-offset-4 hover:text-indigo-200 transition-colors"
    >
      Read my blog →
    </a>

    <SocialLinks />
  </div>
</SiteLayout>
