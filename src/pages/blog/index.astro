---
import { getCollection } from "astro:content";
import { SITE_TITLE } from "../../consts";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { formatDate } from "../../lib/leaflet/format";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
---

<SiteLayout
  title={`Blog - ${SITE_TITLE}`}
  description="Notes on React, TypeScript and web development by Ciarán Curley."
>
  <nav class="mb-8">
    <a
      href="/"
      class="text-white text-shadow-md text-shadow-black/60 hover:text-indigo-200 transition-colors"
    >
      ← Home
    </a>
  </nav>

  <h1 class="text-5xl md:text-7xl font-normal tracking-tight text-white text-shadow-lg text-shadow-black/50 mb-10">
    Blog
  </h1>

  <ul class="max-w-3xl rounded-2xl bg-gray-800 px-6 py-4 md:px-12 md:py-8">
    {posts.map((post) => (
      <li class="py-6">
        <a href={`/blog/${post.id}/`} class="group block">
          <h2 class="text-2xl font-bold text-gray-50 group-hover:text-indigo-300 transition-colors">
            {post.data.title}
          </h2>
          {post.data.description && (
            <p class="mt-1 text-lg text-gray-300">{post.data.description}</p>
          )}
          <p class="mt-2 text-sm text-gray-400">
            <time datetime={post.data.publishedAt.toISOString()}>
              {formatDate(post.data.publishedAt)}
            </time>
          </p>
        </a>
      </li>
    ))}
  </ul>
</SiteLayout>
